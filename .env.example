# Copie estas variáveis para a Netlify em:
# Site settings > Environment variables
# NUNCA coloque valores reais neste arquivo nem no GitHub.

# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon key) do Supabase (Project Settings > API > anon public)
# Usada apenas dentro das Netlify Functions para validar o login (Supabase Auth).
# Não concede acesso aos dados por si só (RLS bloqueia tudo sem a service key).
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service Role Key do Supabase (Project Settings > API > service_role secret)
# Fica só no servidor (Netlify Functions). NUNCA expor esta chave no frontend.
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui
